# Spotter AI — backend environment (Supabase, no Docker)
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Supabase database ---
# Create a free project at https://supabase.com, enable PostGIS under
# Database > Extensions, then copy the "Connection string > URI" from
# Project Settings > Database into DATABASE_URL below.
#
# The URI looks like:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# (or postgres://... — the backend normalizes both to psycopg2).
#
# Required — the backend will NOT start without it.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# --- App ---
DEBUG=false

# --- AI Assistant (LLM API key — optional) ---
# Leave empty to use the deterministic grounded fallback formatter (Phase 29).
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-latest

# --- Demo API key for mutating endpoints (Phase 22) ---
SPOTTER_API_KEY=spotter-demo
